{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"MOS Emergency Situation",
  "type":"object",
  "required":["id","event_type","status","last_updated","facts","unknowns"],
  "properties":{
    "id":{"type":"string","minLength":1},
    "event_type":{"type":"string","enum":["earthquake","flood","landslide","fire","storm","multi_hazard","other"]},
    "status":{"type":"string","enum":["ACTIVE","MONITORING","CLOSED"]},
    "last_updated":{"type":"string","format":"date-time"},
    "facts":{"type":"array","items":{"type":"object","required":["claim_id","category","verification_state","risk","observed_at","received_at","sources"],"properties":{"claim_id":{"type":"string"},"category":{"type":"string","enum":["event","casualties","missing","injuries","affected_people","infrastructure","roads","hospitals","shelters","water","food","rescue","aftershocks","weather","needs","other"]},"verification_state":{"type":"string","enum":["CONFIRMED_EVENT","CONFIRMED_FACT","CORROBORATED_FACT","PENDING_VERIFICATION","CONFLICTING_REPORTS","EXPIRED"]},"risk":{"type":"string","enum":["LOW","MEDIUM","HIGH","CRITICAL"]},"location":{"type":"string"},"observed_at":{"type":"string","format":"date-time"},"received_at":{"type":"string","format":"date-time"},"sources":{"type":"array","minItems":1,"items":{"type":"object","required":["name","url","retrieved_at"],"properties":{"name":{"type":"string","minLength":1},"url":{"type":"string","format":"uri"},"retrieved_at":{"type":"string","format":"date-time"}}}},"version":{"type":"integer","minimum":1},"supersedes":{"type":["string","null"]},"relation":{"type":["string","null"],"enum":["SAME_EVENT","UPDATE","AFTERSHOCK_CANDIDATE","AFTERSHOCK_CONFIRMED","RELATED_EVENT","DIFFERENT_EVENT","AMBIGUOUS",null]}}}},
    "unknowns":{"type":"array","items":{"type":"string"}},
    "source_count":{"type":"integer","minimum":0}
  },
  "additionalProperties":false
}
