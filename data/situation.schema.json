{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"MOS Emergency Situation",
  "type":"object",
  "required":["id","event_type","status","last_updated","facts"],
  "properties":{
    "id":{"type":"string","minLength":1},
    "event_type":{"type":"string","enum":["earthquake","flood","landslide","fire","storm","multi_hazard","other"]},
    "status":{"type":"string","enum":["ACTIVE","MONITORING","CLOSED"]},
    "last_updated":{"type":"string","format":"date-time"},
    "facts":{"type":"array","items":{"type":"object","required":["claim_id","category","verification_state","risk"],"properties":{"claim_id":{"type":"string"},"category":{"type":"string","enum":["event","casualties","missing","injuries","affected_people","infrastructure","roads","hospitals","shelters","water","food","rescue","aftershocks","weather","needs","other"]},"verification_state":{"type":"string","enum":["CONFIRMED_EVENT","CONFIRMED_FACT","CORROBORATED_FACT","PENDING_VERIFICATION","CONFLICTING_REPORTS","EXPIRED"]},"risk":{"type":"string","enum":["LOW","MEDIUM","HIGH","CRITICAL"]},"location":{"type":"string"}}}},
    "unknowns":{"type":"array","items":{"type":"string"}},
    "source_count":{"type":"integer","minimum":0}
  },
  "additionalProperties":false
}
