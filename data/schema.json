{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"MOS Emergency Incident",
  "type":"object",
  "required":["id","status","title","source","source_url","published_at","updated_at"],
  "properties":{
    "id":{"type":"string","pattern":"^MOS-[0-9]{8}-[0-9]{4}$"},
    "status":{"enum":["CONFIRMED","CORROBORATED","PENDING_VERIFICATION","REJECTED","EXPIRED"]},
    "priority":{"enum":["CRITICAL","HIGH","MEDIUM","LOW"]},
    "category":{"enum":["RESCUE","MISSING","VICTIMS","HEALTH","ROADS","SHELTER","WATER","FOOD","SUPPLIES","AFTERSHOCK","WEATHER","LANDSLIDE","OFFICIAL_MEASURE","OTHER"]},
    "title":{"type":"string"},
    "summary":{"type":"string"},
    "department":{"type":"string"},
    "municipality":{"type":"string"},
    "source":{"type":"string"},
    "source_url":{"type":"string","format":"uri"},
    "published_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "verified_at":{"type":["string","null"],"format":"date-time"},
    "verification_note":{"type":["string","null"]},
    "related_sources":{"type":"array","items":{"type":"string","format":"uri"}},
    "human_report":{"type":"boolean"}
  }
}
